@page
@model HanuMediSoftCore.Pages.Hms.Op.Masters.DistrictsModel
@using System.Linq

@{
    ViewData["Title"] = "Districts";
    Layout = "_ProLayout";
}

<div class="container mt-3">

    <div class="compact-header d-flex justify-content-between align-items-center">
        <h3 class="page-title">Districts</h3>

        <div class="d-flex align-items-center gap-2">

            <form method="get" class="d-flex gap-2">
                <input type="text" name="search"
                       value="@Model.Search"
                       class="form-control search-box"
                       placeholder="Search Districts..." />

                <button class="btn btn-outline-secondary btn-sm btn-sm-custom">
                    <i class="bi bi-search"></i>
                </button>
            </form>

            <form method="post">
                <button formaction="?handler=AddNew"
                        class="btn btn-primary btn-sm btn-sm-custom">
                    <i class="bi bi-plus-circle me-1"></i> Add
                </button>
            </form>

        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-sm-custom">
            <thead>
                <tr>
                    <th>District Name</th>
                    <th>Description</th>
                    <th>State</th>
                    <th class="text-center">Active</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>

                <!-- NEW ROW -->
                @if (Model.ShowNewRow)
                {
                    <form method="post">
                    <tr class="new-row">

                        <td>
                            <input class="form-control form-control-sm-custom"
                                   name="NewRow.DistrictName"
                                   placeholder="District name" />
                        </td>

                        <td>
                            <input class="form-control form-control-sm-custom"
                                   name="NewRow.DistrictCode"
                                   placeholder="District Code" />
                        </td>

                        <td>
                            <select class="form-control form-control-sm-custom"
                                    name="NewRow.StateId">
                                    @foreach (var c in Model.ListStates)
                                    {
                                    <option value="@c.StateId">@c.StateName</option>
                                    }
                            </select>
                        </td>

                        <td class="text-center">
                            <input type="checkbox"
                                   class="form-check-input checkbox-sm"
                                   name="NewRow.IsActive"
                                   value="1"
                                   checked />
                            <input type="hidden" name="NewRow.IsActive" value="0" />
                        </td>

                        <td class="text-center">
                            <button formaction="?handler=SaveNew"
                                    class="btn btn-success btn-sm btn-sm-custom">
                                <i class="bi bi-check"></i>
                            </button>

                            <button formaction="?handler=CancelNew"
                                    class="btn btn-secondary btn-sm btn-sm-custom">
                                <i class="bi bi-x"></i>
                            </button>
                        </td>
                    </tr>
                    </form>
                }

                <!-- EXISTING ROWS -->
                @foreach (var u in Model.ListDistricts)
                {
                    bool isEditing = (Model.EditingId == u.StateId);

                    <form method="post">
                    <tr class="@(isEditing ? "editing-row" : "")">

                        <input type="hidden" name="EditRow.StateId" value="@u.DistrictId" />

                        <td>
                                @if (isEditing)
                                {
                                <input class="form-control form-control-sm-custom"
                                       name="EditRow.DistrictName"
                                       value="@u.DistrictName" />
                                }
                                else
                                {
                                    @u.DistrictName
                                }
                        </td>

                        <td>
                                @if (isEditing)
                                {
                                <input class="form-control form-control-sm-custom"
                                       name="EditRow.DistrictCode"
                                       value="@u.DistrictCode" />
                                }
                                else
                                {
                                    @u.DistrictCode
                                }
                        </td>

                        <!-- COUNTRY -->
                        <td>
                                @if (isEditing)
                                {
                                <select class="form-control form-control-sm-custom"
                                        name="EditRow.StateId">
                                        @foreach (var c in Model.ListStates)
                                        {
                                        <option value="@c.StateId" selected="@(u.StateId == c.StateId)">
                                                @c.StateName
                                        </option>
                                        }
                                </select>
                                }
                                else
                                {
                                    @Model.ListStates.FirstOrDefault(x => x.StateId == u.StateId)?.StateName


                                }
                        </td>

                        <td class="text-center">
                                @if (isEditing)
                                {
                                <input type="checkbox"
                                       class="form-check-input checkbox-sm"
                                       name="EditRow.IsActive"
                                       value="1"
                                    @(u.IsActive == 1 ? "checked" : "") />
                                <input type="hidden" name="EditRow.IsActive" value="0" />
                                }
                                else
                                {
                                <span class="status-badge @(u.IsActive == 1 ? "status-active" : "status-inactive")">
                                        @(u.IsActive == 1 ? "Yes" : "No")
                                </span>
                                }
                        </td>

                        <td class="text-center">
                                @if (isEditing)
                                {
                                <button formaction="?handler=SaveEdit&id=@u.DistrictId"
                                        class="btn btn-success btn-sm btn-sm-custom">
                                    <i class="bi bi-check"></i>
                                </button>

                                <button formaction="?handler=CancelEdit"
                                        class="btn btn-secondary btn-sm btn-sm-custom">
                                    <i class="bi bi-x"></i>
                                </button>
                                }
                                else
                                {
                                <button formaction="?handler=Edit&id=@u.DistrictId"
                                        class="btn btn-outline-primary btn-sm btn-sm-custom">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                }
                        </td>

                    </tr>
                    </form>
                }

            </tbody>

        </table>
    </div>

</div>

