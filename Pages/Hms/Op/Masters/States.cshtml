
@page
@model HanuMediSoftCore.Pages.Hms.Op.Masters.StatesModel
@using System.Linq
@{
    ViewData["Title"] = "States";
    Layout = "_ProLayout";
}
<div class="container mt-3">

    <div class="compact-header d-flex justify-content-between align-items-center">
        <h3 class="page-title">States</h3>

        <div class="d-flex align-items-center gap-2">

            <form method="get" class="d-flex gap-2">
                <input type="text" name="search"
                       value="@Model.Search"
                       class="form-control search-box"
                       placeholder="Search states..." />

                <button class="btn btn-outline-secondary btn-sm btn-sm-custom">
                    <i class="bi bi-search"></i>
                </button>
            </form>

            <form method="post">
                <button formaction="?handler=AddNew"
                        class="btn btn-primary btn-sm btn-sm-custom">
                    <i class="bi bi-plus-circle me-1"></i> Add
                </button>
            </form>

        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-sm-custom">
            <thead>
                <tr>
                    <th>State Name</th>
                    <th>Description</th>
                    <th>Country</th>
                    <th class="text-center">Active</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>

                <!-- NEW ROW -->
                @if (Model.ShowNewRow)
                {
                    <form method="post">
                    <tr class="new-row">

                        <td>
                            <input class="form-control form-control-sm-custom"
                                   name="NewRow.StateName"
                                   placeholder="State name" />
                        </td>

                        <td>
                            <input class="form-control form-control-sm-custom"
                                   name="NewRow.StateCode"
                                   placeholder="State Code" />
                        </td>

                        <td>
                            <select class="form-control form-control-sm-custom"
                                    name="NewRow.CountryId">
                                @foreach (var c in Model.ListCountries)
                                {
                                    <option value="@c.CountryId">@c.CountryName</option>
                                }
                            </select>
                        </td>

                        <td class="text-center">
                            <input type="checkbox"
                                   class="form-check-input checkbox-sm"
                                   name="NewRow.IsActive"
                                   value="1"
                                   checked />
                            <input type="hidden" name="NewRow.IsActive" value="0" />
                        </td>

                        <td class="text-center">
                            <button formaction="?handler=SaveNew"
                                    class="btn btn-success btn-sm btn-sm-custom">
                                <i class="bi bi-check"></i>
                            </button>

                            <button formaction="?handler=CancelNew"
                                    class="btn btn-secondary btn-sm btn-sm-custom">
                                <i class="bi bi-x"></i>
                            </button>
                        </td>
                    </tr>
                    </form>
                }

                <!-- EXISTING ROWS -->
                @foreach (var u in Model.ListStates)
                {
                    bool isEditing = (Model.EditingId == u.StateId);

                    <form method="post">
                    <tr class="@(isEditing ? "editing-row" : "")">

                        <input type="hidden" name="EditRow.StateId" value="@u.StateId" />

                        <td>
                            @if (isEditing)
                            {
                                <input class="form-control form-control-sm-custom"
                                       name="EditRow.StateName"
                                       value="@u.StateName" />
                            }
                            else
                            {
                                @u.StateName
                            }
                        </td>

                        <td>
                            @if (isEditing)
                            {
                                <input class="form-control form-control-sm-custom"
                                       name="EditRow.StateCode"
                                       value="@u.StateCode" />
                            }
                            else
                            {
                                @u.StateCode
                            }
                        </td>

                        <!-- COUNTRY -->
                        <td>
                            @if (isEditing)
                            {
                                <select class="form-control form-control-sm-custom"
                                        name="EditRow.CountryId">
                                    @foreach (var c in Model.ListCountries)
                                    {
                                        <option value="@c.CountryId" selected="@(u.CountryId == c.CountryId)">
                                                @c.CountryName
                                        </option>
                                    }
                                </select>
                            }
                            else
                            {
                                @Model.ListCountries.FirstOrDefault(x => x.CountryId == u.CountryId)?.CountryName

 
                            }
                        </td>

                        <td class="text-center">
                            @if (isEditing)
                            {
                                <input type="checkbox"
                                       class="form-check-input checkbox-sm"
                                       name="EditRow.IsActive"
                                       value="1"
                                       @(u.IsActive == 1 ? "checked" : "") />
                                <input type="hidden" name="EditRow.IsActive" value="0" />
                            }
                            else
                            {
                                <span class="status-badge @(u.IsActive == 1 ? "status-active" : "status-inactive")">
                                    @(u.IsActive == 1 ? "Yes" : "No")
                                </span>
                            }
                        </td>

                        <td class="text-center">
                            @if (isEditing)
                            {
                                <button formaction="?handler=SaveEdit&id=@u.StateId"
                                        class="btn btn-success btn-sm btn-sm-custom">
                                    <i class="bi bi-check"></i>
                                </button>

                                <button formaction="?handler=CancelEdit"
                                        class="btn btn-secondary btn-sm btn-sm-custom">
                                    <i class="bi bi-x"></i>
                                </button>
                            }
                            else
                            {
                                <button formaction="?handler=Edit&id=@u.StateId"
                                        class="btn btn-outline-primary btn-sm btn-sm-custom">
                                    <i class="bi bi-pencil"></i>
                                </button>
                            }
                        </td>

                    </tr>
                    </form>
                }

            </tbody>

        </table>
    </div>

</div>

