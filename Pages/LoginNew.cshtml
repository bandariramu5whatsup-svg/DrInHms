@page
@model CoreRazorDemo.Pages.LoginNewModel
@{
} 

<h2>Login</h2>

<form method="post">
    <label>Username</label>
    <input name="UserName" required class="form-control" />

    <label>Password</label>
    <input type="password" name="Password" required class="form-control" />

    <button class="btn btn-success mt-2">Login</button>
</form>

@if (Model.Error != null)
{
    <div class="alert alert-danger mt-3">@Model.Error</div>
}

@if (Model.Message != null)
{
    <div class="alert alert-success mt-3">@Model.Message</div>
}
